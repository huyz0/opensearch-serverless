#!/usr/bin/env bash
# Fast checks on every commit (seconds, no build). The whole gate runs on
# push (.githooks/pre-push). See docs/ci.md.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
cargo fmt --all --check
scripts/tree-checks.sh --quiet
echo "pre-commit: fast checks ok (the full gate runs on push)"
